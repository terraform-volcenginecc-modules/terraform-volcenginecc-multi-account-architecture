region         = "cn-beijing"
project        = "cloud-identity-demo"
environment    = "prod"
root_parent_id = "替换为企业组织根 OU ID"

# 资源栈一键部署无法在中途暂停等待控制台操作，因此默认跳过人工门禁。
skip_financial_relation_gate = true
# 新账号创建完成后，等待企业组织将账号同步到云身份中心。
cloud_identity_account_propagation_wait = "180s"
identity_source_mode                    = "local"

organization_units = [
  {
    key           = "ou_core"
    name          = "Core"
    description   = "运维、安全、日志等核心账号"
    parent_ou_key = ""
  },
  {
    key           = "ou_workloads"
    name          = "Workloads"
    description   = "业务负载账号"
    parent_ou_key = ""
  },
  {
    key           = "ou_production"
    name          = "Production"
    description   = "生产环境"
    parent_ou_key = "ou_workloads"
  },
]

organization_accounts = [
  {
    mode                        = "create"
    account_name                = "replace-ops-001"
    show_name                   = "Operation"
    description                 = "运维管理账号"
    org_unit_key                = "ou_core"
    allow_console               = 1
    verification_relation_id    = ""
    account_type                = "operation"
    existing_account_id         = ""
    financial_relation_verified = false
    tags = [
      { key = "CostCenter", value = "OPS-001" },
    ]
  },
  {
    mode                        = "create"
    account_name                = "replace-sec-001"
    show_name                   = "Security"
    description                 = "安全审计账号"
    org_unit_key                = "ou_core"
    allow_console               = 1
    verification_relation_id    = ""
    account_type                = "security"
    existing_account_id         = ""
    financial_relation_verified = false
    tags = [
      { key = "CostCenter", value = "SEC-001" },
    ]
  },
  {
    mode                        = "create"
    account_name                = "replace-log-001"
    show_name                   = "Logging"
    description                 = "日志归集账号"
    org_unit_key                = "ou_core"
    allow_console               = 1
    verification_relation_id    = ""
    account_type                = "logging"
    existing_account_id         = ""
    financial_relation_verified = false
    tags = [
      { key = "CostCenter", value = "LOG-001" },
    ]
  },
  {
    mode                        = "create"
    account_name                = "replace-prod-001"
    show_name                   = "Production"
    description                 = "生产业务账号"
    org_unit_key                = "ou_production"
    allow_console               = 1
    verification_relation_id    = ""
    account_type                = "production"
    existing_account_id         = ""
    financial_relation_verified = false
    tags = [
      { key = "CostCenter", value = "PROD-001" },
    ]
  },
  {
    mode                        = "create"
    account_name                = "replace-stg-001"
    show_name                   = "Staging"
    description                 = "预发测试账号"
    org_unit_key                = "ou_workloads"
    allow_console               = 1
    verification_relation_id    = ""
    account_type                = "staging"
    existing_account_id         = ""
    financial_relation_verified = false
    tags = [
      { key = "CostCenter", value = "STG-001" },
    ]
  },
]

cloud_identity_users = [
  {
    key                     = "platform_admin"
    user_name               = "platform-admin"
    display_name            = "Platform Administrator"
    description             = "平台管理员"
    email                   = "platform-admin@example.com"
    phone                   = ""
    password_reset_required = true
  },
  {
    key                     = "auditor"
    user_name               = "security-auditor"
    display_name            = "Security Auditor"
    description             = "安全审计员"
    email                   = "security-auditor@example.com"
    phone                   = ""
    password_reset_required = true
  },
]

# 在资源栈平台的敏感参数中填写，不要提交真实密码。
cloud_identity_user_passwords = {}

cloud_identity_groups = [
  {
    key          = "grp_platform_admin"
    group_name   = "PlatformAdministrators"
    display_name = "Platform Administrators"
    description  = "平台管理员组"
    join_type    = "Manual"
    member_keys  = ["platform_admin"]
  },
  {
    key          = "grp_security_audit"
    group_name   = "SecurityAuditors"
    display_name = "Security Auditors"
    description  = "安全审计组"
    join_type    = "Manual"
    member_keys  = ["auditor"]
  },
]

external_principals = {}

permission_sets = [
  {
    key              = "ps_admin"
    name             = "PlatformAdmin"
    description      = "平台管理权限"
    session_duration = 3600
    relay_state      = "https://console.volcengine.com/"
    permission_policies = [
      {
        permission_policy_name     = "AdministratorAccess"
        permission_policy_type     = "System"
        permission_policy_document = ""
      },
    ]
  },
  {
    key              = "ps_readonly"
    name             = "SecurityReadOnly"
    description      = "安全审计只读权限"
    session_duration = 7200
    relay_state      = "https://console.volcengine.com/"
    permission_policies = [
      {
        permission_policy_name     = "ReadOnlyAccess"
        permission_policy_type     = "System"
        permission_policy_document = ""
      },
    ]
  },
]

permission_set_assignments = [
  {
    permission_set_key = "ps_admin"
    principal_type     = "Group"
    principal_key      = "grp_platform_admin"
    target_account_key = "replace-ops-001"
    target_account_id  = ""
  },
  {
    permission_set_key = "ps_readonly"
    principal_type     = "Group"
    principal_key      = "grp_security_audit"
    target_account_key = "replace-prod-001"
    target_account_id  = ""
  },
]
